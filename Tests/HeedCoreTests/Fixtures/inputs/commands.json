{
  "root": "/w/repo",
  "notSafeRead": [
    {"command": "env sh -c 'cat a'", "checks": "a shell a runner starts is not followed"},
    {"command": "env sh -c 'rm -rf a'", "checks": "a shell a runner starts"},
    {"command": "env -i /bin/sh -c ls", "checks": "a runner with options before the shell"},
    {"command": "awk '{print}' a | sh", "checks": "a pipe into a shell"},
    {"command": "awk 'BEGIN{system(\"rm a\")}'", "checks": "awk running a command"},
    {"command": "awk '{print > \"out\"}' a", "checks": "awk writing a file"},
    {"command": "rg --pre ./run foo", "checks": "rg running a preprocessor"},
    {"command": "rg --pre=cat foo", "checks": "rg's preprocessor, joined"},
    {"command": "rg --pre-glob '*.x' --pre ./run foo", "checks": "rg's preprocessor with a glob"},
    {"command": "fd -x rm", "checks": "fd running a command per file"},
    {"command": "fd -tf -X rm", "checks": "fd running a batch"},
    {"command": "fd -tfx rm", "checks": "fd's exec in a short cluster"},
    {"command": "fd --exec rm", "checks": "fd's long exec"},
    {"command": "find . -exec rm {} \\;", "checks": "find running a command"},
    {"command": "find . -execdir rm {} +", "checks": "find running a command per folder"},
    {"command": "find . -delete", "checks": "find deleting"},
    {"command": "find . -fprint out", "checks": "find writing a file"},
    {"command": "sort -o out a", "checks": "sort writing a file"},
    {"command": "sort -uo out a", "checks": "sort's output in a short cluster"},
    {"command": "sort --output=out a", "checks": "sort's long output"},
    {"command": "sort --compress-program=sh a", "checks": "sort running a program"},
    {"command": "git diff --output=out", "checks": "git diff writing a file"},
    {"command": "git diff --output out", "checks": "git diff writing a file, spaced"},
    {"command": "git -c core.pager=sh log", "checks": "git with config that runs a program"},
    {"command": "git --exec-path=/tmp status", "checks": "git with an exec path"},
    {"command": "git branch -D main", "checks": "git deleting a branch"},
    {"command": "git remote add x https://example.invalid", "checks": "git changing remotes"},
    {"command": "sed -n 'w out' a", "checks": "sed's w command"},
    {"command": "sed 's/a/b/w out' a", "checks": "sed's w flag"},
    {"command": "sed -i s/a/b/ a", "checks": "sed in place"},
    {"command": "sed -e 'e ls' a", "checks": "sed's e command"},
    {"command": "less a", "checks": "a pager runs commands"},
    {"command": "more a", "checks": "a pager runs commands"},
    {"command": "vim a", "checks": "an editor"},
    {"command": "cat ../../etc/passwd", "checks": "a path that climbs out"},
    {"command": "cat ../other/a", "checks": "a sibling folder"},
    {"command": "ls ..", "checks": "the parent"},
    {"command": "cd .. && ls", "checks": "cd out, then read"},
    {"command": "cat /etc/hosts", "checks": "an absolute path outside"},
    {"command": "cat ~/.ssh/id_ed25519", "checks": "a home path"},
    {"command": "head -n 1 src/../../x", "checks": "a path that climbs through a folder"},
    {"command": "PATH=/tmp ls", "checks": "a variable that changes what runs"},
    {"command": "GIT_PAGER=sh git log", "checks": "a pager variable"},
    {"command": "LD_PRELOAD=x cat a", "checks": "a preload variable"},
    {"command": "VAR=x cat a", "checks": "any variable but locale and time zone"},
    {"command": "./ls", "checks": "a program named by a relative path"},
    {"command": "/tmp/cat a", "checks": "a program outside the system's folders"},
    {"command": "cat a > out", "checks": "a redirect writes"},
    {"command": "echo x >> a", "checks": "an append writes"},
    {"command": "ls | tee out", "checks": "tee writes"},
    {"command": "xargs rm", "checks": "xargs runs its command"},
    {"command": "echo `rm a`", "checks": "backquotes run a command"},
    {"command": "echo $(rm a)", "checks": "a command substitution runs"},
    {"command": "eval 'cat a'", "checks": "eval runs its words"},
    {"command": "bash -c 'cat a'", "checks": "a shell is not followed"},
    {"command": "tree -o out", "checks": "tree writing a file"},
    {"command": "date -s 12:00", "checks": "setting the clock"},
    {"command": "uniq a out", "checks": "uniq's second file is written"},
    {"command": "gh api -X POST repos/o/r/issues", "checks": "a gh api write"},
    {"command": "gh api repos/o/r/issues -f title=x", "checks": "a gh api field write"},
    {"command": "gh pr merge 1", "checks": "a merge"},
    {"command": "gh pr checkout 1", "checks": "a checkout writes files"},
    {"command": "python3 -c 'print(1)'", "checks": "an interpreter"},
    {"command": "ls; rm a", "checks": "one reader and one writer"},
    {"command": "file -C -m x", "checks": "file compiling a magic file"}
  ],
  "safeRead": [
    {"command": "ls", "checks": "a listing"},
    {"command": "ls -la src", "checks": "a listing with options"},
    {"command": "cat a", "checks": "a file in the worktree"},
    {"command": "cat src/a.swift", "checks": "a file in a folder"},
    {"command": "git status", "checks": "git status"},
    {"command": "git log --oneline -5", "checks": "git log"},
    {"command": "git diff", "checks": "git diff"},
    {"command": "git -C . status", "checks": "git with a folder"},
    {"command": "rg foo", "checks": "a search"},
    {"command": "rg -n foo src", "checks": "a search with options"},
    {"command": "grep -r foo .", "checks": "grep"},
    {"command": "find . -name '*.swift'", "checks": "find, listing"},
    {"command": "fd swift", "checks": "fd, listing"},
    {"command": "sort a", "checks": "sort to the terminal"},
    {"command": "sed -n 1,10p a", "checks": "sed printing"},
    {"command": "head -n 5 a | wc -l", "checks": "a pipe of readers"},
    {"command": "LANG=C ls", "checks": "a locale"},
    {"command": "jq . a.json", "checks": "jq"},
    {"command": "gh pr view 1", "checks": "gh reading"}
  ],
  "publishes": [
    {"command": "npm publish", "checks": "npm"},
    {"command": "yarn npm publish", "checks": "yarn's npm"},
    {"command": "cargo publish", "checks": "cargo"},
    {"command": "gh release create v1", "checks": "a release"},
    {"command": "gh workflow run deploy.yml", "checks": "a workflow run"},
    {"command": "git push --tags", "checks": "tags"},
    {"command": "git push origin refs/tags/v1", "checks": "a tag ref"},
    {"command": "git push origin tag v1", "checks": "a tag by word"},
    {"command": "docker push img", "checks": "an image"},
    {"command": "docker buildx build --push .", "checks": "a build that pushes"},
    {"command": "kubectl apply -f k.yml", "checks": "a deploy"},
    {"command": "terraform apply", "checks": "infrastructure"},
    {"command": "helm upgrade app chart", "checks": "a chart"},
    {"command": "dotnet nuget push x.nupkg", "checks": "nuget"},
    {"command": "mise run release", "checks": "a release task"},
    {"command": "make deploy", "checks": "a deploy task"},
    {"command": "npm run publish:npm", "checks": "a publish task"},
    {"command": "env npm publish", "checks": "behind a runner"},
    {"command": "sudo -u ci npm publish", "checks": "behind a runner with a value"},
    {"command": "bash -c 'npm publish'", "checks": "inside a shell"},
    {"command": "cd pkg && npm publish", "checks": "after cd"},
    {"command": "NODE_ENV=production npm publish", "checks": "after a variable"},
    {"command": "fly deploy", "checks": "fly"},
    {"command": "vercel --prod", "checks": "vercel"}
  ],
  "notPublishes": [
    {"command": "npm test", "checks": "a test"},
    {"command": "git push origin main", "checks": "a branch push"},
    {"command": "docker build .", "checks": "a build"},
    {"command": "gh release view v1", "checks": "reading a release"},
    {"command": "kubectl get pods", "checks": "reading a cluster"},
    {"command": "mise run test", "checks": "a test task"},
    {"command": "make", "checks": "a build"},
    {"command": "echo npm publish", "checks": "the words as text"}
  ]
}
